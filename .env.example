# Required
DATABASE_URL=postgresql://user:password@host:5432/a11y
LLM_API_KEY=your-moonshot-api-key

# Deployment note: with docker-compose.coolify.yml, set the public domain
# in the Coolify UI (the SERVICE_FQDN_API_3000 var handles Traefik routing).
# Self-hosting elsewhere? Put the api behind your own reverse proxy.

# Optional (shown with defaults)
LLM_API_BASE_URL=https://api.moonshot.ai/v1
PORT=3000
NODE_ENV=production
REPORTS_DIR=./reports
