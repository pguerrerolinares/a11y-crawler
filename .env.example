# Required
DATABASE_URL=postgresql://user:password@host:5432/a11y
LLM_API_KEY=your-moonshot-api-key

# Deployment (docker-compose.coolify.yml / Traefik)
# APP_HOST: public hostname for the app, e.g. a11y.example.com
APP_HOST=a11y.example.com
# BASIC_AUTH_USERS: Traefik basicauth users, format user:htpasswd-hash
# generate with: echo "$(openssl passwd -apr1 YOUR_PASSWORD)"
BASIC_AUTH_USERS=user:$$apr1$$REPLACE_WITH_YOUR_HASH

# Optional (shown with defaults)
LLM_API_BASE_URL=https://api.moonshot.ai/v1
PORT=3000
NODE_ENV=production
REPORTS_DIR=./reports
