# Dockerfile.worker — Audit Worker (Playwright client, NO Chromium)
# Bundle with esbuild (keepNames=false to avoid __name in page.evaluate),
# run with Node (Bun WebSocket incompatible with Playwright connect).

FROM oven/bun:1 AS build
WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile
COPY src/ src/
COPY tsconfig.json ./
RUN bunx esbuild src/worker/index.ts --bundle --platform=node --format=esm \
    --outfile=dist/worker.mjs --keep-names=false \
    --external:playwright --external:@axe-core/playwright --external:postgres

FROM node:22-slim
WORKDIR /app
COPY --from=build /app/node_modules node_modules/
COPY --from=build /app/dist/worker.mjs ./

ENV NODE_ENV=production

CMD ["node", "worker.mjs"]
